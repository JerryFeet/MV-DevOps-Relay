@@ -0,0 +1,83 @@
+import type { Lang } from "@/contexts/LanguageContext";
+
+export const DAY_MS = 24 * 60 * 60 * 1000;
+
+export type AttentionUrgency = "normal" | "attention" | "overdue";
+
+export type AttentionThresholds = {
+  attentionDays: number;
+  overdueDays: number;
+};
+
+export type AttentionQueueSummary = {
+  key: string;
+  count: number;
+  oldestAt: string | null;
+  originalIndex: number;
+};
+
+export function normalizeAttentionThresholds(
+  attentionDays: unknown,
+  overdueDays: unknown,
+): AttentionThresholds {
+  const parsedAttention = Number(attentionDays);
+  const safeAttention = Number.isInteger(parsedAttention) && parsedAttention >= 1
+    ? parsedAttention
+    : 2;
+  const parsedOverdue = Number(overdueDays);
+  const safeOverdue = Number.isInteger(parsedOverdue) && parsedOverdue >= 1
+    ? parsedOverdue
+    : 7;
+
+  return {
+    attentionDays: safeAttention,
+    overdueDays: Math.max(safeAttention, safeOverdue),
+  };
+}
+
+export function waitingAgeDays(oldestAt: string | null, nowMs = Date.now()): number {
+  if (!oldestAt) return 0;
+  const timestamp = new Date(oldestAt).getTime();
+  if (!Number.isFinite(timestamp)) return 0;
+  return Math.max(0, (nowMs - timestamp) / DAY_MS);
+}
+
+export function attentionUrgency(
+  oldestAt: string | null,
+  thresholds: AttentionThresholds,
+  nowMs = Date.now(),
+): AttentionUrgency {
+  const ageDays = waitingAgeDays(oldestAt, nowMs);
+  if (ageDays > thresholds.overdueDays) return "overdue";
+  if (ageDays >= thresholds.attentionDays) return "attention";
+  return "normal";
+}
+
+export function sortAttentionQueues<T extends AttentionQueueSummary>(queues: T[]): T[] {
+  return [...queues].sort((left, right) => {
+    const leftHasWork = left.count > 0;
+    const rightHasWork = right.count > 0;
+    if (leftHasWork !== rightHasWork) return leftHasWork ? -1 : 1;
+
+    if (leftHasWork && rightHasWork) {
+      const leftOldest = left.oldestAt ? new Date(left.oldestAt).getTime() : Number.POSITIVE_INFINITY;
+      const rightOldest = right.oldestAt ? new Date(right.oldestAt).getTime() : Number.POSITIVE_INFINITY;
+      if (leftOldest !== rightOldest) return leftOldest - rightOldest;
+    }
+
+    return left.originalIndex - right.originalIndex;
+  });
+}
+
+export function formatWaitingAge(oldestAt: string, lang: Lang, nowMs = Date.now()): string {
+  const days = Math.floor(waitingAgeDays(oldestAt, nowMs));
+  if (lang === "ar") {
+    if (days < 1) return "أقل من يوم";
+    if (days === 1) return "يوم واحد";
+    if (days === 2) return "يومين";
+    return `${days} أيام`;
+  }
+
+  if (days < 1) return "less than 1 day";
+  return `${days} ${days === 1 ? "day" : "days"}`;
+}
