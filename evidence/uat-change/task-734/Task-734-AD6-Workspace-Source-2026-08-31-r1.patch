+import { describe, expect, it } from "vitest";
+import {
+  DAY_MS,
+  attentionUrgency,
+  formatWaitingAge,
+  normalizeAttentionThresholds,
+  sortAttentionQueues,
+} from "@/lib/adminDashboard";
+
+describe("AD6 admin attention ageing", () => {
+  const now = Date.UTC(2026, 7, 31, 12);
+
+  it("uses the approved normal, attention, and overdue boundaries", () => {
+    const thresholds = { attentionDays: 2, overdueDays: 7 };
+
+    expect(attentionUrgency(new Date(now - (2 * DAY_MS) + 1).toISOString(), thresholds, now)).toBe("normal");
+    expect(attentionUrgency(new Date(now - (2 * DAY_MS)).toISOString(), thresholds, now)).toBe("attention");
+    expect(attentionUrgency(new Date(now - (7 * DAY_MS)).toISOString(), thresholds, now)).toBe("attention");
+    expect(attentionUrgency(new Date(now - (7 * DAY_MS) - 1).toISOString(), thresholds, now)).toBe("overdue");
+  });
+
+  it("enforces a one-day minimum and prevents overdue from preceding attention", () => {
+    expect(normalizeAttentionThresholds(0, 1)).toEqual({ attentionDays: 2, overdueDays: 2 });
+    expect(normalizeAttentionThresholds(5, 3)).toEqual({ attentionDays: 5, overdueDays: 5 });
+  });
+
+  it("sorts queues with work first, oldest work first, and empty queues last", () => {
+    const sorted = sortAttentionQueues([
+      { key: "empty-a", count: 0, oldestAt: null, originalIndex: 0 },
+      { key: "newer", count: 9, oldestAt: "2026-08-30T12:00:00.000Z", originalIndex: 1 },
+      { key: "older", count: 1, oldestAt: "2026-08-20T12:00:00.000Z", originalIndex: 2 },
+      { key: "empty-b", count: 0, oldestAt: null, originalIndex: 3 },
+    ]);
+
+    expect(sorted.map((queue) => queue.key)).toEqual(["older", "newer", "empty-a", "empty-b"]);
+  });
+
+  it("formats the oldest age in English and Arabic", () => {
+    const oldestAt = new Date(now - (3 * DAY_MS)).toISOString();
+    expect(formatWaitingAge(oldestAt, "en", now)).toBe("3 days");
+    expect(formatWaitingAge(oldestAt, "ar", now)).toBe("3 أيام");
+  });
+});
